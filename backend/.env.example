# Finnhub API key (https://finnhub.io) — used for real-time candles, news, and symbol search.
# If unset, the backend falls back to yfinance for price data (no news/search).
FINNHUB_API_KEY=

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default is http://localhost:5173 (Vite). Add your deployed frontend URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Free Gemini API key (https://aistudio.google.com/apikey) — powers the AI deep-insights
# and Q&A chat features (/api/ai-insights, /api/ai-chat). Optional: those two endpoints
# return {"configured": false} and the rest of the app works normally if this is unset.
GEMINI_API_KEY=
